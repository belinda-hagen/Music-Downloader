{
  "name": "playgen",
  "productName": "Music Downloader",
  "version": "1.4.0",
  "description": "YouTube music downloader & playlist manager",
  "desktopName": "Music Downloader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/generate-icons.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "keywords": [
    "electron",
    "youtube",
    "music",
    "playlist"
  ],
  "author": "Belinda Hagen",
  "license": "MIT",
  "build": {
    "appId": "com.musicdownloader.app",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "!assets/bin/**/*",
      "package.json"
    ],
    "artifactName": "Music-Downloader-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/playgen-icon.ico",
      "extraResources": [
        {
          "from": "assets/bin",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/playgen-icon",
      "category": "AudioVideo",
      "syncDesktopName": true
    },
    "nsis": {
      "guid": "027c5436-fd07-503f-a445-5b12e0f03c2a",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/playgen-icon.ico",
      "uninstallerIcon": "assets/playgen-icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
